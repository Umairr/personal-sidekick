# Copy this file to .env and fill in your own values. Never commit .env.

# Model: "provider:model". Examples:
#   openai:gpt-5.4-mini            anthropic:claude-opus-5-5
#   google_genai:gemini-2.5-flash  groq:llama-3.3-70b-versatile
#   ollama:qwen3:14b               openrouter:anthropic/claude-sonnet-5.5
SIDEKICK_MODEL=openai:gpt-5.4-mini
# Optional: a cheaper model just for grading answers (defaults to SIDEKICK_MODEL)
SIDEKICK_EVALUATOR_MODEL=

# API key for whichever provider you use (only that one is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: any OpenAI-compatible server (LM Studio, vLLM, Together…) with the "openai:" prefix
SIDEKICK_BASE_URL=
SIDEKICK_API_KEY=

# Required for web search
SERPER_API_KEY=

# Push notifications (Pushover)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-sidekick

# Optional
SIDEKICK_PORT=8765

# Required when the app is reachable from the internet (Docker on a server, AWS…)
SIDEKICK_USERNAME=
SIDEKICK_PASSWORD=
