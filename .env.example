# Copy this file to .env and fill in your own values. Never commit .env.

# Required
OPENAI_API_KEY=
SERPER_API_KEY=

# Push notifications (Pushover)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-sidekick

# Optional
SIDEKICK_MODEL=gpt-5.4-mini
SIDEKICK_PORT=8765

# Required when the app is reachable from the internet (Docker on a server, AWS…)
SIDEKICK_USERNAME=
SIDEKICK_PASSWORD=
